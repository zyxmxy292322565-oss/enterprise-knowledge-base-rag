ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}
ARG REUSE_DEPENDENCIES=0
WORKDIR /app
COPY requirements.txt requirements.runtime.lock.txt ./
RUN if [ "$REUSE_DEPENDENCIES" != "1" ]; then \
      pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu && \
      pip install --no-cache-dir -r requirements.runtime.lock.txt; \
    fi && pip install --no-cache-dir pymilvus==2.6.17
COPY *.py ./
COPY deployment/ ./deployment/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RAG_DEPLOYMENT_MODE=docker
CMD ["uvicorn", "deployment.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
